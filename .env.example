# Режим работы: development — пользователи в access.json,
#               production  — пользователи в PostgreSQL.
APP_ENV=development

# UID/GID владельца каталога data/ на хосте (для записи access.json в Docker).
UID=1000
GID=1000

# PostgreSQL (используется при APP_ENV=production).
# В Docker бот подключается к сервису postgres; POSTGRES_HOST нужен только
# при запуске bot.py вне Docker.
POSTGRES_DB=docstatus
POSTGRES_USER=docstatus
POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
